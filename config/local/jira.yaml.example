# Jira source configuration.
#
# Copy this file to jira.yaml in the same directory and edit it. jira.yaml is
# git-ignored so operator edits never conflict with repository updates.
#
# sites define a connection (site url and auth_mode of cloud or datacenter) once
# and are reused. default is the identity (site, account fields, token, board)
# applied to any allowlisted project not listed under projects. A projects entry
# overrides the site, account, token, or board for one project, and anything it
# leaves unset inherits the default. A cloud identity carries an email and a
# token_ref for the API token, and a datacenter identity carries a token_ref for
# the PAT. Tokens are named references resolved from the local .env now and
# Secrets Manager in AWS.

sites:
  cloud:
    url: https://your-org.atlassian.net
    auth_mode: cloud
  # datacenter:
  #   url: https://jira.example.com
  #   auth_mode: datacenter

default:
  site: cloud
  email: agent@example.com
  token_ref: JIRA_API_TOKEN
  board: AGENTDEV

projects: {}
  # OPS:                         # its own board, same cloud site and account
  #   board: OPS
  # PLATFORM:                    # a project on the datacenter site with a PAT
  #   site: datacenter
  #   token_ref: JIRA_PAT
  #   board: PLATFORM
