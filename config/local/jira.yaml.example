# sites define a connection (site url and cloud or datacenter auth_mode) once and are reused.
# default is the identity applied to any allowlisted project not listed under projects, and a
# projects entry overrides the site, account, token, or board for one. allowlist is the set of
# reachable projects. acceptance_field names the Jira field holding acceptance criteria.
# token_ref names an environment variable holding the token. statuses lists the board's status
# names, and flow maps work_started and ready_for_review onto concrete statuses. Every flow
# status must appear in statuses or the config fails closed at load. Leave a flow stage unset
# to skip it. A board with no review status keeps the ticket in its work_started status and
# relies on the pull request linkback as the review signal.

config_version: 1

allowlist:
  - AGENTDEV

acceptance_field: ""

sites:
  cloud:
    url: https://your-org.atlassian.net
    auth_mode: cloud
  # datacenter:
  #   url: https://jira.example.com
  #   auth_mode: datacenter

default:
  site: cloud
  email: agent@example.com
  token_ref: JIRA_API_TOKEN
  board: AGENTDEV
  statuses: [Backlog, Selected for Development, In Progress, In Review, Done]
  flow:
    work_started: In Progress
    ready_for_review: In Review

projects: {}
  # OPS:                         # its own board, same cloud site and account
  #   board: OPS
  # PLATFORM:                    # a datacenter board with no review status
  #   site: datacenter
  #   token_ref: JIRA_PAT
  #   board: PLATFORM
  #   statuses: [Backlog, Selected for Development, In Progress, Done]
  #   flow:
  #     work_started: In Progress
