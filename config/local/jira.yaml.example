# sites define a connection (site url and cloud or datacenter auth_mode) once and are reused.
# default is the identity applied to any allowlisted project not listed under projects, and a
# projects entry overrides the site, account, token, or board for one. allowlist is the set of
# reachable projects. acceptance_field names the Jira field holding acceptance criteria.
# token_ref names an environment variable holding the token. statuses lists the board's status
# names, and flow maps work_started and ready_for_review onto concrete statuses. Every flow
# status must appear in statuses or the config fails closed at load. Leave a flow stage unset
# to skip it. A board with no review status keeps the ticket in its work_started status and
# relies on the pull request linkback as the review signal. default_repo is the intake target
# when a ticket names no repository, and must be in the github allowlist. intake_label, when set,
# gates intake so only issues carrying that Jira label enter the platform, and leaving it unset
# admits every not-Done issue in the project. It resolves per project with the default as the
# fallback, the same as board and default_repo. component_repos maps a ticket's Jira component
# names to one repository or a list, and a ticket routes to the union of its components' repos.
# An explicit repos: marker in the description overrides it, and a component with no mapping is
# ignored. It resolves per project with the default as the fallback.
# dependency_link_type names an existing Jira issue link type (for example "Blocks") used to
# record a discovered cross-ticket dependency, where the blocking issue blocks the dependent
# issue. It resolves per project with the default as the fallback. Leaving it unset turns off
# dependency recording for that project, so the run publishes its touch set but records nothing
# and pauses on nothing. Projects that share a repository must use the same link type.

config_version: 1

allowlist:
  - AGENTDEV

acceptance_field: ""

sites:
  cloud:
    url: https://your-org.atlassian.net
    auth_mode: cloud
  # datacenter:
  #   url: https://jira.example.com
  #   auth_mode: datacenter

default:
  site: cloud
  email: agent@example.com
  token_ref: JIRA_API_TOKEN
  board: AGENTDEV
  default_repo: agentic-demo-service
  intake_label: adp
  dependency_link_type: Blocks
  component_repos:
    Backend: agentic-demo-service
    # Frontend: agentic-demo-ts
    # Shared: [agentic-demo-service, agentic-demo-ts]
  statuses: [Backlog, Selected for Development, In Progress, In Review, Done]
  flow:
    work_started: In Progress
    ready_for_review: In Review

projects: {}
  # OPS:                         # its own board, same cloud site and account
  #   board: OPS
  #   intake_label: ops-adp      # override the intake label for this project
  # PLATFORM:                    # a datacenter board with no review status
  #   site: datacenter
  #   token_ref: JIRA_PAT
  #   board: PLATFORM
  #   statuses: [Backlog, Selected for Development, In Progress, Done]
  #   flow:
  #     work_started: In Progress
