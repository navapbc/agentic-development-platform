# Tenant beta's alert channels and Slack settings, in the format of
# config/local/escalation.yaml.example. Rename it to escalation.yaml to use it. beta posts to its
# own Slack app over Socket Mode, and its profile repeats the profile of beta/gates.yaml.
config_version: 1

channels:
  - jira
  - email
  - slack

slack:
  transport: socket
  channel: C0000000001
  organization_id: T0000000001
  app_id: A0000000001
  profile: private
  allowlist:
    gate:
      - user_id: U0000000001
    repair:
      - user_id: U0000000001
