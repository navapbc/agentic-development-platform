# Settings and credentials that only tenant beta's activity worker receives. Copy to beta.env.
# A value here replaces the .env value of the same name for this worker. A worker other than the
# home tenant's receives none of GITHUB_TOKEN, JIRA_API_TOKEN, JIRA_PAT, REGISTRY_TOKEN,
# SLACK_WEBHOOK_URL, or the AUTHORSHIP_* settings of .env, so set the ones beta needs here.
TICKET_BACKEND=rebar
# The bearer token clients of beta's MCP gateway present on /mcp. The render refuses a tenant
# without one or with another tenant's token, and .env never supplies it. Replace it with the
# output of `openssl rand -hex 32`.
MCP_GATEWAY_TOKEN=change-me-beta-locally
# GITHUB_TOKEN=
# SLACK_WEBHOOK_URL=
# AUTHORSHIP_IDENTITY_ID=
# AUTHORSHIP_SIGNING_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
# ...
# -----END OPENSSH PRIVATE KEY-----"
