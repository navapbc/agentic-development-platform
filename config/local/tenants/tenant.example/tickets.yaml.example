config_version: 1

# Operational config for the rebar ticket backend. repo_root points at the
# git-backed rebar store working tree, an absolute path in the tenant's
# workspace /tenants/<tenant>. Replace <tenant> here and in store.prefix with
# the tenant name, because the render refuses a store outside the tenant's
# workspace or a prefix that overlaps another tenant's.
# status_flow resolves the platform's logical lifecycle stages to the store's
# own statuses. rebar's status vocabulary is idea, open, in_progress, closed,
# blocked, cancelled, deleted.
backend:
  repo_root: /tenants/<tenant>/rebar-tickets
  project: ADSER
  default_repo: agentic-demo-service
  status_flow:
    work_started: in_progress
    ready_for_review: in_progress
    terminal: closed

# The change-detection poll runs under an authenticated reader identity
# restricted to approved roles. Non-allowlisted fields are redacted from poll
# output by default.
poll:
  reader_roles:
    - tickets-reader
  identity_roles:
    agent-platform@users.noreply.invalid: tickets-reader
  allowed_fields:
    - ticket_id
    - title
    - status
    - ticket_type
    - priority
    - description
    - repos
    - tags
    - comments

# The rebar ticket store uses its own bucket or prefix, isolated from the
# evidence and audit stores. The read-only polling role and the write role are
# distinct, and neither reuses the evidence or audit writer role. The store's git
# remote fetches under reader_profile and pushes under writer_profile, two AWS
# profiles that assume the roles below. inv rebar-store-remote sets the remote.
store:
  bucket: rebar-tickets
  prefix: <tenant>/tickets/
  reader_profile: rebar-tickets-reader
  writer_profile: rebar-tickets-writer

roles:
  read_only: arn:aws:iam::000000000000:role/rebar-tickets-reader
  write: arn:aws:iam::000000000000:role/rebar-tickets-writer

# Actor and run provenance are required on every tickets-branch ref write.
provenance:
  require_actor: true
  require_run_id: true
