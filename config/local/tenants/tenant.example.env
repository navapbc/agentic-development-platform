# Settings and credentials that only this tenant's pods receive. Copy to <tenant>.env beside the
# tenant's folder. A value here replaces the config/local/platform.env value of the same name for
# the tenant. No other tenant receives any value of this file.
# TICKET_BACKEND=rebar
# The bearer token clients of the tenant's MCP gateway present on /mcp. The render refuses a tenant
# without one or with another tenant's token. Replace it with the output of
# `openssl rand -hex 32`.
MCP_GATEWAY_TOKEN=change-me-locally
# The integration tokens that the tenant's github.yaml and jira.yaml name through token_ref.
# GITHUB_TOKEN=
# JIRA_API_TOKEN=
# JIRA_PAT=
# The token of the tenant's registry identity, which an external registries.yaml mode requires.
# REGISTRY_TOKEN=
# The OpenSSH private key the tenant's review worker signs review verdicts with. It must be an active
# key of this tenant in config/local/review-trust-root.yaml, and no other tenant may hold it. The
# render refuses a tenant without one while REVIEW_SIGNING_ENABLED is true.
# REVIEW_SIGNING_KEY="<every line of the OpenSSH private key file, in one double-quoted value>"
# The HMAC secrets that sign the tenant's inbound deliveries. An integration whose mode in
# integrations.yaml is webhook or hybrid refuses the tenant's deliveries without its secret.
# GITHUB_WEBHOOK_SECRET=
# JIRA_WEBHOOK_SECRET=
# SLACK_WEBHOOK_URL=
# The tenant's own Slack app. No two tenants may share a Slack app, its tokens, its signing secret, or
# an ESCALATION_ACTION_KEY, which is the output of `openssl rand -hex 32`.
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_SIGNING_SECRET=
# ESCALATION_ACTION_KEY=
# The rebar identity the tenant's authoring agent signs as, and its private signing key, either as a
# path on the host or as the key itself.
# AUTHORSHIP_IDENTITY_ID=
# AUTHORSHIP_SIGNING_KEY_PATH=
# AUTHORSHIP_SIGNING_KEY="<every line of the OpenSSH private key file, in one double-quoted value>"
