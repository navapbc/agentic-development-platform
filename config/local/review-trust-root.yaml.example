# Review-verdict trust root. Copy to review-trust-root.yaml and set the signer
# public keys. The review gate verifies each review verdict signature against the
# keys of the run's tenant active at review time. Only public keys belong here.
#
# Each key names the tenant whose review worker signs with it and carries a stable
# identifier. A tenant's keys bind to the principal review-signer@<tenant>, so a
# verdict signed with one tenant's key does not verify for another tenant's run. A
# key is active when it is not revoked and the current time is within its validity
# window (both bounds optional). Overlapping windows give a rotation rollout that
# admits a new key before the old key retires. A revoked key is never trusted.
version: 1
keys:
  - id: review-key-adp-2026-01
    tenant: adp
    public_key: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEXAMPLEONLYreplaceThisWithARealPublicKey review-signer@adp"
    not_before: "2026-01-01T00:00:00Z"
    not_after: "2026-12-31T23:59:59Z"
    revoked: false
