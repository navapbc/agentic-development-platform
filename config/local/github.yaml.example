# hosts define a connection (REST API base and git base) once and are reused. default is the
# identity applied to every repository with backend github in repositories.yaml, which lists
# the repositories and may override the host, owner, or token_ref for one. token_ref names an
# environment variable holding the token.

config_version: 2

hosts:
  github-com:
    api_url: https://api.github.com
    git_base_url: https://github.com
  # enterprise:
  #   api_url: https://ghe.example.com/api/v3
  #   git_base_url: https://ghe.example.com

default:
  host: github-com
  owner: agentic-demo
  token_ref: GITHUB_TOKEN
