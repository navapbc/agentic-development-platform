# GitHub source configuration.
#
# Copy this file to github.yaml in the same directory and edit it. github.yaml is
# git-ignored so operator edits never conflict with repository updates.
#
# hosts define a connection (REST API base and git base) once and are reused.
# default is the identity (host, owner, token) applied to any allowlisted
# repository not listed under repositories. A repositories entry overrides the
# host, owner, or token for one repository, and anything it leaves unset inherits
# the default. Tokens are named references resolved from the local .env now and
# Secrets Manager in AWS.

hosts:
  github-com:
    api_url: https://api.github.com
    git_base_url: https://github.com
  # enterprise:
  #   api_url: https://ghe.example.com/api/v3
  #   git_base_url: https://ghe.example.com

default:
  host: github-com
  owner: agentic-demo
  token_ref: GITHUB_TOKEN

repositories: {}
  # billing-svc:                 # its own token, same host and owner as the default
  #   token_ref: BILLING_TOKEN
  # partner-app:                 # a different owner on github.com
  #   owner: partner-org
  # legacy-core:                 # a repository on the enterprise host
  #   host: enterprise
  #   owner: platform
