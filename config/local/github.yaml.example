# hosts define a connection (REST API base and git base) once and are reused. default is the
# identity applied to any allowlisted repository not listed under repositories, and a
# repositories entry overrides the host, owner, or token for one. allowlist is the set of
# reachable repositories. token_ref names an environment variable holding the token.

config_version: 1

allowlist:
  - agentic-demo-service
  - agentic-demo-greenfield
  - agentic-demo-ts
  - agentic-demo-tf
  - agentic-demo-java
  - agentic-demo-php
  - agentic-demo-ruby

hosts:
  github-com:
    api_url: https://api.github.com
    git_base_url: https://github.com
  # enterprise:
  #   api_url: https://ghe.example.com/api/v3
  #   git_base_url: https://ghe.example.com

default:
  host: github-com
  owner: agentic-demo
  token_ref: GITHUB_TOKEN

repositories: {}
  # billing-svc:                 # its own token, same host and owner as the default
  #   token_ref: BILLING_TOKEN
  # partner-app:                 # a different owner on github.com
  #   owner: partner-org
  # legacy-core:                 # a repository on the enterprise host
  #   host: enterprise
  #   owner: platform
