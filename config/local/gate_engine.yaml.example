# Optional external gates that back their own review or scanner gates plus the advisory test
# classifier. The adapter is tool-agnostic. It drives any tool whose entrypoint accepts
# --against <ref> and --json-out <path> and writes either SARIF 2.1.0 or the review and classifier
# JSON contract, selected per entry by output_format. The path is inert unless at least one engine
# is enabled, so with this file absent or every engine disabled the built-in rebar security review
# stays the gate. Every external gate is added here by config.
#
# engines is a list. Each entry backs one gate, named by name, and is enabled and required
# independently in gates.yaml. The two entries below are the example engines under
# examples/gate-engines, a deterministic SARIF security scan and a test coverage review that asks
# the model gateway for suggested test cases. See examples/gate-engines/README.md.

config_version: 1

engines:
  - name: security-policy
    enabled: false

    # How the platform parses the engine's --json-out file.
    #   review-json: the review JSON contract. The engine receives the model gateway.
    #   sarif:       SARIF 2.1.0, the native output of Semgrep, Snyk, CodeQL, Trivy, and most
    #                scanners. No model is needed, so tool and review_model are ignored.
    output_format: sarif

    # Source mode. Set mode to one of image, local, tag, or zip, then fill the fields it reads.
    #   image: image, or the entry GATE_ENGINE_IMAGES holds for this name when image is empty
    #   local: local_path
    #   tag:   repo_url, tag, cache_root
    #   zip:   zip_path, cache_root (create with: gh api repos/<org>/<repo>/zipball/<ref> > x.zip)
    # image runs the harness inside the published image. The source modes copy the engine into the
    # gate pod and build its Dockerfile there, which needs the package registries the Dockerfile
    # installs from. The resolver records the image, commit, or zip hash into the run manifest.
    mode: image
    image: ""

    # Harness path inside the engine, relative to its root. Required for an enabled engine.
    review_entrypoint: bin/scan

  - name: test-policy
    enabled: false
    output_format: review-json

    # The model the engine's calls use, a canonical-id group of the LiteLLM config such as
    # claude-opus-5-5, which both the gateway routes to Bedrock through the guardrails and an AI CLI
    # recognizes. An alias group such as review-model is refused. tool is the AI CLI a review-json
    # engine drives, and max_output_tokens caps its output.
    review_model: claude-opus-5-5
    tool: claude
    max_output_tokens: 8192

    mode: image
    image: ""
    review_entrypoint: bin/review

    # Harness path of the advisory test classifier, which runs in the activity worker. Empty runs
    # no classifier. triage_model is the model it uses.
    classifier_entrypoint: ""
    triage_model: review-model

  # An engine in its own repository, pinned to a tag and built from its Dockerfile in the gate pod.
  # - name: sonarqube-review
  #   enabled: true
  #   output_format: sarif
  #   mode: tag
  #   repo_url: https://github.com/your-org/sonar-review-engine.git
  #   tag: v1.0.0
  #   cache_root: .agent-context/engine-cache
  #   review_entrypoint: bin/scan

  # An engine checkout on the workstation, which inv repos-sync copies into the cluster with its
  # uncommitted edits. local_path is relative to the platform checkout.
  # - name: custom-review
  #   enabled: true
  #   output_format: review-json
  #   review_model: claude-opus-5-5
  #   mode: local
  #   local_path: ../custom-review-engine
  #   review_entrypoint: bin/review
