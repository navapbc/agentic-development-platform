623ba52382327fe9b88","dep 9a1f61448009300112bb4c49d46b4b248564cf1e71f8e8d1990844c7ccf112a8 tasks.py","dep fb2c18f25234d39ced3b860021c7a60e8bbe1eae239e69ae5dc50f4f7a802383 tests/unit/test_tasks_compose.py","read-set: 8","read-path: compose.override.yaml","read-path: compose.yaml","read-path: pyproject.toml","read-path: scripts/demo_durable_counter.py","read-path: scripts/durability_proof.py","read-path: services/integration/credentials.py","read-path: tasks.py","read-path: tests/unit/test_tasks_compose.py","currency-basis: file_impact"],"material_fingerprint":"7d2dec399d2bdb3f","merged_log_commit":"4c1b77807851ed5387acd623ba52382327fe9b88","principal":"8c3ef925-fbdc-4d88-8d59-f391cf59568c","signature":null,"signed_at":1790012992004118000}},"author":"Joe Oakhart","author_email":"joeoakhart@navapbc.com","authorship":{"signed":0,"unsigned":12},"authorship_ledger":[],"bridge_alerts":[],"bridge_project":null,"claim_harness":null,"claim_remote_session":null,"claimed_session":null,"close_class":"preexisting","comments":[{"author":"Joe Oakhart","author_email":"joeoakhart@navapbc.com","body":"PR #31 at 9e9fd51. Plan review signed PASS 0 blocking 0 advisory. Code review PASS 0 blocking 0 advisory. Local inv ci 1489 passed 6 skipped eval-gate PASS. GitHub CI pass in 2m42s. Each acceptance criterion selector proven individually and falsified by reverting the COMPOSE_FILE guard.","timestamp":1790013858983402001}],"completion_expectation":"required","created_at":1790012253819771001,"creation_channel":"cli","deps":[{"link_uuid":"9f0cddb5-49c0-4ff4-88d4-4aa7fc2f90eb","relation":"relates_to","target_id":"9624-e64b-f88b-4b94"},{"link_uuid":"4accb899-9a20-4b80-bd3f-1af0fee9f8fc","relation":"relates_to","target_id":"0304-e96b-f3eb-41a1"},{"link_uuid":"9af74144-0026-4413-95f6-34331ea053b5","relation":"relates_to","target_id":"06ca-3120-6d9d-4243"}],"description":"`_compose_files()` in `tasks.py:13-17` builds a fixed `-f compose.yaml [-f compose.override.yaml]` argument list. Passing explicit `-f` flags overrides the `COMPOSE_FILE` environment variable, so every `inv` task that shells out to Compose operates on a different projection of the stack than the one the operator started.\n\nThe running stack on the pilot machine carries a third overlay. `docker inspect` reports `com.docker.compose.project.config_files` as `compose.yaml,compose.override.yaml,compose.massgov.yaml`. `inv up`, `inv down`, `inv stop`, `inv logs`, `inv migrate`, `inv db-reset`, and `_run_scripted` all drop that third file.\n\nRecreating services without the overlay moves published ports back to their base values, drops the target repository mounts the workers need, and re-enables services the overlay disables by profile. On this machine the overlay places `schedule-bootstrap` in a disabled profile, so an `inv up` would install the Temporal intake schedule and begin unattended intake.\n\nDocker Compose already resolves `COMPOSE_FILE` from the project `.env`, verified with a probe. The extension point exists and the task runner bypasses it. Honouring it keeps the mechanism generic, because the platform learns nothing about any particular overlay.\n\n## Acceptance Criteria\n- [x] The compose argument list is empty when `COMPOSE_FILE` is set, so Compose resolves the file list itself, proven by `pytest tests/unit/test_tasks_compose.py -k compose_files_defers_to_the_compose_file_environment_variable`\n- [x] The compose argument list falls back to the base file when `COMPOSE_FILE` is unset, proven by `pytest tests/unit/test_tasks_compose.py -k compose_files_falls_back_to_the_base_file`\n- [x] The compose argument list adds the override file when that file is present in a project with no `COMPOSE_FILE` setting, proven by `pytest tests/unit/test_tasks_compose.py -k compose_files_adds_the_override_file_when_present`\n- [x] A `COMPOSE_FILE` value defined only in the project `.env` is honoured, proven by `pytest tests/unit/test_tasks_compose.py -k compose_files_reads_the_compose_file_variable_from_the_env_file`\n\n## Testing\nRun each acceptance criterion selector on its own. Run `PATH=\"$PWD/.venv/bin:$PATH\" .venv/bin/inv ci` before closing the ticket.","env_id":"8c3ef925-fbdc-4d88-8d59-f391cf59568c","file_impact":[{"path":"tasks.py","reason":"Defer to COMPOSE_FILE when the operator sets it in the environment or the project .env"},{"path":"tests/unit/test_tasks_compose.py","reason":"First coverage of the compose argument builder, including both COMPOSE_FILE sources"}],"file_impact_scope":"paths","keyring":[],"last_status_env_id":"8c3ef925-fbdc-4d88-8d59-f391cf59568c","managed_refs":[["relates_to","0304-e96b-f3eb-41a1"],["relates_to","06ca-3120-6d9d-4243"],["relates_to","9624-e64b-f88b-4b94"]],"no_file_impact_reason":"","parent_id":null,"parent_status_uuid":"f1019d3e-cd96-48ed-b4ee-f3f6d428e5fb","plan_review_phase":"execution","preconditions_summary":{"status":"pre-manifest"},"priority":2,"repos":[],"reverts":[],"status":"closed","tags":["adp","compose","tooling"],"ticket_id":"41e9-7091-dd2c-44d0","ticket_type":"bug","title":"Honour COMPOSE_FILE in the invoke task runner so inv tasks target the running stack","verify_commands":[]},"source_event_uuids":["9f7f1e1b-b3cb-47dc-ad74-40d77952b461","3ba979ca-04d6-4abf-9700-a844d5bcfea5","9f0cddb5-49c0-4ff4-88d4-4aa7fc2f90eb","edf58d69-6ed5-4a2c-add3-7fcdd46b50ff","d68c5c43-4b3f-4945-8e4c-987fa71444e4","4accb899-9a20-4b80-bd3f-1af0fee9f8fc","9af74144-0026-4413-95f6-34331ea053b5","904949e0-6e85-49ff-9bd2-9895fc88efce","3251d1f2-6c22-4644-a023-7410bac08d97","7ad9ccd2-c5a3-4a64-8c66-2af7b09859dc","f1019d3e-cd96-48ed-b4ee-f3f6d428e5fb","b6f439e6-a226-4fef-b2fa-b8cf93ceba6e"]},"env_id":"8c3ef925-fbdc-4d88-8d59-f391cf59568c","event_type":"SNAPSHOT","timestamp":1790016875227549001,"uuid":"8ab45071-b872-4345-8fb4-0cf480179e46"}