# Secrets and local env
.env
.env.*
!.env.example
*.pem
*.key

# Per-environment config edited by the operator (ship the .example template only)
config/*/github.yaml
!config/*/github.yaml.example
config/*/jira.yaml
!config/*/jira.yaml.example
config/*/integrations.yaml
!config/*/integrations.yaml.example

# AWS / credentials
.aws/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Local data / evidence
data/
evidence/
repository_indexes/**/index/
*.sqlite
*.db

# Vendored prebuilt binaries (kept locally, copied into containers, never committed)
vendor/bin/*
!vendor/bin/.gitkeep

# Terraform
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Agent working context
.agent-context/
.agent-workspaces/

# Generated local k8s secret env (derived from .env at deploy time)
deploy/kubernetes/local/*.secret.env
