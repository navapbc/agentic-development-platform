#!/bin/bash
# Configures an Amazon Linux 2023 NAT instance following the AWS VPC user guide NAT AMI steps.
set -euo pipefail

retry() {
  for attempt in $(seq 1 30); do
    "$@" && return 0
    sleep 10
  done
  return 1
}

# The Elastic IP is associated after launch, so package installs wait until the instance can reach the repositories.
retry dnf -y install iptables-services amazon-ssm-agent
retry dnf -y upgrade --security

systemctl enable --now amazon-ssm-agent
systemctl enable --now iptables

cat > /etc/sysctl.d/90-nat.conf <<'EOF'
net.ipv4.ip_forward = 1
EOF
sysctl --system

egress_interface="$(ip -4 route show default | awk '{print $5; exit}')"

iptables -t nat -F POSTROUTING
%{ for cidr in source_cidr_blocks ~}
iptables -t nat -A POSTROUTING -o "$egress_interface" -s ${cidr} -j MASQUERADE
%{ endfor ~}
iptables -F FORWARD
iptables-save > /etc/sysconfig/iptables
