# agentic-dev-platform local environment (placeholders only).
# Copy to `.env` and fill in locally. Never commit real secrets.

ENVIRONMENT=local
LOG_LEVEL=INFO

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=agent_platform

DATABASE_URL=postgresql+asyncpg://platform:change-me-locally@postgres:5432/agent_platform
ALEMBIC_DATABASE_URL=postgresql+psycopg://platform:change-me-locally@localhost:5432/agent_platform

TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agent-platform

AWS_PROFILE=mpse-legacy
AWS_REGION=us-east-1
BEDROCK_RUNTIME_ENDPOINT=com.amazonaws.us-east-1.bedrock-runtime
BEDROCK_PROXY_URL=
BEDROCK_RUNTIME_HOST=bedrock-runtime.us-east-1.amazonaws.com
# Injected endpoint URL for boto3 / BedrockConverseModel. Empty uses the default
# regional resolver; set it for an in-VPC interface-endpoint or per-project host.
BEDROCK_ENDPOINT_URL=
# Connectivity provider: jumphost | ssh-bastion | direct | public
BEDROCK_CONNECTIVITY_PROVIDER=jumphost
# Public endpoint is off by default (synthetic-data dev only, explicit sign-off).
ALLOW_PUBLIC_BEDROCK_ENDPOINT=false

# jumphost provider (example values below are the OSRE test path).
JUMPHOST_NAME=osre-opis-jumphost
JUMPHOST_ENV=util
JUMPHOST_CONNECT_SCRIPT=
# ssh-bastion provider (user@host or an ssh_config alias).
SSH_BASTION_TARGET=
BEDROCK_TUNNEL_LOCAL_PORT=8443

LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=change-me-locally

REBAR_LLM_BASE_URL=http://litellm:4000
REBAR_LLM_MODEL=review-model
REBAR_LLM_MODEL_PROVIDER=openai
REBAR_HMAC_SECRET=change-me-locally

OPA_URL=http://opa:8181

LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_SALT=change-me-locally
LANGFUSE_ENCRYPTION_KEY=
NEXTAUTH_SECRET=change-me-locally

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

ALLOWLIST_JIRA_PROJECTS=AGENTDEV
ALLOWLIST_REPOS=agentic-demo-service,agentic-demo-greenfield,agentic-demo-ts,agentic-demo-tf,agentic-demo-java

JIRA_URL=
JIRA_BASE_URL=
JIRA_AUTH_MODE=cloud
JIRA_PROJECT=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PAT=
# Options: jira (Cloud, default) | jira-datacenter (Server/Data Center, PAT auth)
REBAR_RECONCILER_BACKEND=jira

GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=

JENKINS_URL=http://jenkins:8080
JENKINS_USER=
JENKINS_API_TOKEN=
